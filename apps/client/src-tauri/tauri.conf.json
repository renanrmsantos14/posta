{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Posta",
  "version": "0.1.4",
  "identifier": "br.com.renan.posta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:36480",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Posta",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyMjUwODgyNjM4M0U5QTAKUldTZzZZTmpnZ2dsQXZWRDBnQkFCN0YrcVFWaDMvZmExNUFmRFZGTDQyTVhyNS9TWkh3UjJsVFIK",
      "endpoints": [
        "https://github.com/renanrmsantos14/posta/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
