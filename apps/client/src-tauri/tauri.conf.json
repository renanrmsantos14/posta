{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Posta",
  "version": "0.0.0",
  "identifier": "br.com.renan.posta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:36480",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Posta", "width": 1280, "height": 820, "minWidth": 360, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
